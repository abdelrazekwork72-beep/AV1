// OpenMedia Premiere Pro Importer Windows Resource Script (v3.0.1)
// Binary-exact Adobe MediaCore 7.0 IMPT (1000) & PiPL (16000) resources.
// FourCC: 0x4F4D4950 ('OMIP') — strictly avoids reserved After Effects FourCC.
// Registration tokens: OpenMedia Importer | 1.0.0.0 | xImportEntry

#include <winresrc.h>

#define OPENMEDIA_IMPORTER_FOURCC       0x4F4D4950
#define OPENMEDIA_IMPORTER_NAME         "OpenMedia Importer"
#define OPENMEDIA_IMPORTER_ENTRY        "xImportEntry"
#define OPENMEDIA_IMPORTER_VERSION_STR  "1.0.0.0"

// ---------------------------------------------------------------------------
// IMPT Resource Table (Adobe MediaCore Importer Registration: 4 bytes \x00\x00IN)
// ---------------------------------------------------------------------------
1000 IMPT DISCARDABLE
BEGIN
    0x0000,
    0x4E49
END

// ---------------------------------------------------------------------------
// PiPL Resource Table (Adobe Plug-in Property List - Binary Little-Endian 8BIM)
// ---------------------------------------------------------------------------
16000 PiPL DISCARDABLE
BEGIN
    0x0001,                         // Version = 1 (16-bit)
    0x00000000L,                    // kPiPLVersion = 0 (32-bit)
    0x00000003L,                    // Property Count = 3 (32-bit)

    // Property 1: '8BIM' 'kind' = 'IMPT'
    0x3842494DL,                    // '8BIM' ("MIB8")
    0x6B696E64L,                    // 'kind' ("dnik")
    0x00000000L,                    // 0L
    0x00000004L,                    // 4L
    0x494D5054L,                    // 'IMPT' ("TPMI")

    // Property 2: '8BIM' 'name' = "\022OpenMedia Importer" (18 chars + 1 len + 1 pad = 20L)
    0x3842494DL,                    // '8BIM'
    0x6E616D65L,                    // 'name'
    0x00000000L,                    // 0L
    0x00000014L,                    // 20L
    "\022OpenMedia Importer\0",

    // Property 3: '8BIM' 'eMNA' = "\011OpenMedia" (9 chars + 1 len + 2 pad = 12L)
    0x3842494DL,                    // '8BIM'
    0x654D4E41L,                    // 'eMNA'
    0x00000000L,                    // 0L
    0x0000000CL,                    // 12L
    "\011OpenMedia\0\0"
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     3,0,1,0
PRODUCTVERSION  3,0,1,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x2L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OpenMedia\0"
            VALUE "FileDescription",  "OpenMedia Importer (Premiere Pro, Media Encoder, After Effects)\0"
            VALUE "FileVersion",      "3.0.1 (1.0.0.0)\0"
            VALUE "InternalName",     "OpenMedia_Importer (xImportEntry)\0"
            VALUE "OriginalFilename", "OpenMedia_Importer.prm\0"
            VALUE "ProductName",      "OpenMedia Importer\0"
            VALUE "ProductVersion",   "3.0.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
