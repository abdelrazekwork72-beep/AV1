// OpenMedia Premiere Pro Importer Windows Resource Script
// Defines IMPT and PiPL binary resource tables and version metadata.
// FourCC: 0x4F4D4950 ('OMIP') — strictly avoids reserved After Effects FourCC.

#include <winresrc.h>

#define OPENMEDIA_IMPORTER_FOURCC      0x4F4D4950
#define OPENMEDIA_IMPORTER_NAME        "OpenMedia Importer"
#define OPENMEDIA_IMPORTER_ENTRY       "xImportEntry"
#define OPENMEDIA_IMPORTER_VERSION_STR "1.0.0.0"

// ---------------------------------------------------------------------------
// IMPT Resource Table (Adobe MediaCore Importer Registration)
// ---------------------------------------------------------------------------
1000 IMPT DISCARDABLE
BEGIN
    0x0001,                         // Resource format version
    OPENMEDIA_IMPORTER_FOURCC,      // Plugin FourCC: 'OMIP' (0x4F4D4950)
    "OpenMedia Importer\0",         // Display / match name
    "1.0.0.0\0",                    // Plugin version
    "xImportEntry\0"                // Primary importer entry point
END

// ---------------------------------------------------------------------------
// PiPL Resource Table (Adobe Plug-in Property List)
// ---------------------------------------------------------------------------
16000 PiPL DISCARDABLE
BEGIN
    0x0001,                         // kPiPLVersion
    0x00000000L,                    // Reserved
    0x00000007L,                    // Property count

    // Property 1: Kind ('IMPT')
    "8BIM", "kind", 0L, 4L,
    "IMPT",

    // Property 2: Name ("OpenMedia Importer")
    "8BIM", "name", 0L, 20L,
    "OpenMedia Importer\0\0",

    // Property 3: Version (1.0.0.0)
    "8BIM", "vers", 0L, 4L,
    0x00010000L,

    // Property 4: Windows x64 Entry Point ("xImportEntry")
    "8BIM", "wx86", 0L, 14L,
    "xImportEntry\0\0",

    // Property 5: FourCC ('OMIP' / 0x4F4D4950)
    "8BIM", "fccc", 0L, 4L,
    OPENMEDIA_IMPORTER_FOURCC,

    // Property 6: Importer Match Name
    "8BIM", "immn", 0L, 20L,
    "OpenMedia Importer\0\0",

    // Property 7: Priority (100)
    "8BIM", "prio", 0L, 4L,
    0x00000064L
END

// ---------------------------------------------------------------------------
// Windows Version Information (1.0.0.0)
// ---------------------------------------------------------------------------
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x2L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OpenMedia\0"
            VALUE "FileDescription",  "OpenMedia Importer\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "OpenMedia_Importer\0"
            VALUE "OriginalFilename", "OpenMedia_Importer.prm\0"
            VALUE "ProductName",      "OpenMedia Importer\0"
            VALUE "ProductVersion",   "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
