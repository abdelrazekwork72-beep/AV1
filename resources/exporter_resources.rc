// OpenMedia Premiere Pro & Media Encoder Exporter Windows Resource Script
// Defines EXPT and PiPL binary resource tables and version metadata.

#include <winresrc.h>

#define OPENMEDIA_EXPORTER_FOURCC      0x4F4D4D4B
#define OPENMEDIA_EXPORTER_NAME        "OpenMedia Exporter"
#define OPENMEDIA_EXPORTER_ENTRY       "xSDKExport"
#define OPENMEDIA_EXPORTER_VERSION_STR "2.0.0.0"

1001 RCDATA
BEGIN
    "OpenMedia_Exporter\0",
    "xSDKExport\0",
    "2.0.0.0\0"
END

1000 EXPT DISCARDABLE
BEGIN
    0x0001,
    OPENMEDIA_EXPORTER_FOURCC,
    "OpenMedia Exporter\0",
    "2.0.0.0\0",
    "xSDKExport\0"
END

16000 PiPL DISCARDABLE
BEGIN
    0x0001,
    0x00000000L,
    0x00000006L,

    "8BIM", "kind", 0L, 4L,
    "EXPT",

    "8BIM", "name", 0L, 20L,
    "OpenMedia Exporter\0\0",

    "8BIM", "vers", 0L, 4L,
    0x00020000L,

    "8BIM", "wx86", 0L, 12L,
    "xSDKExport\0\0",

    "8BIM", "fccc", 0L, 4L,
    OPENMEDIA_EXPORTER_FOURCC,

    "8BIM", "exmn", 0L, 20L,
    "OpenMedia Exporter\0\0"
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x2L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OpenMedia\0"
            VALUE "FileDescription",  "OpenMedia AV1/VP9/MKV/WebM Exporter\0"
            VALUE "FileVersion",      "2.0.0.0\0"
            VALUE "InternalName",     "OpenMedia_Exporter\0"
            VALUE "OriginalFilename", "OpenMedia_Exporter.prm\0"
            VALUE "ProductName",      "OpenMedia Exporter\0"
            VALUE "ProductVersion",   "2.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
