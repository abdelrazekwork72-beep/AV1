// OpenMedia Premiere Pro & Media Encoder Exporter Windows Resource Script (v3.0.2)
// Binary-exact Adobe MediaCore 7.0 EXPT (1000), PiPL (16000) & SxS RT_MANIFEST (2) resources.

#include <winresrc.h>

#define OPENMEDIA_EXPORTER_FOURCC       0x4F4D4D4B
#define OPENMEDIA_EXPORTER_NAME         "OpenMedia Exporter"
#define OPENMEDIA_EXPORTER_ENTRY        "xSDKExport"
#define OPENMEDIA_EXPORTER_VERSION_STR  "3.0.2.0"

2 24 "openmedia_sxs.manifest"

1000 EXPT DISCARDABLE
BEGIN
    0x0000,
    0x5845
END

16000 PiPL DISCARDABLE
BEGIN
    0x0001,
    0x00000000L,
    0x00000003L,

    // Property 1: '8BIM' 'kind' = 'EXPT'
    0x3842494DL,
    0x6B696E64L,
    0x00000000L,
    0x00000004L,
    0x45585054L,

    // Property 2: '8BIM' 'name' = "\022OpenMedia Exporter" (18 chars + 1 len + 1 pad = 20L)
    0x3842494DL,
    0x6E616D65L,
    0x00000000L,
    0x00000014L,
    "\022OpenMedia Exporter\0",

    // Property 3: '8BIM' 'eMNA' = "\011OpenMedia" (9 chars + 1 len + 2 pad = 12L)
    0x3842494DL,
    0x654D4E41L,
    0x00000000L,
    0x0000000CL,
    "\011OpenMedia\0\0"
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     3,0,2,0
PRODUCTVERSION  3,0,2,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x2L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OpenMedia\0"
            VALUE "FileDescription",  "OpenMedia AV1/VP9/MKV/WebM Exporter (xSDKExport)\0"
            VALUE "FileVersion",      "3.0.2 (2.0.0.0)\0"
            VALUE "InternalName",     "OpenMedia_Exporter\0"
            VALUE "OriginalFilename", "OpenMedia_Exporter.prm\0"
            VALUE "ProductName",      "OpenMedia Exporter\0"
            VALUE "ProductVersion",   "3.0.2.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
