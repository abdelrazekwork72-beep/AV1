// OpenMedia Premiere Pro High-Priority Importer Windows Resource Script
// PiPL name includes a trailing space ("OpenMedia Importer ") to avoid Adobe registration collision.

#include <winresrc.h>

#define OPENMEDIA_IMPORTER_HP_FOURCC   0x4F4D4948
#define OPENMEDIA_IMPORTER_HP_NAME     "OpenMedia Importer "
#define OPENMEDIA_IMPORTER_HP_ENTRY    "xImportEntry"
#define OPENMEDIA_IMPORTER_VERSION_STR "1.0.0.0"

1000 IMPT DISCARDABLE
BEGIN
    0x0001,
    OPENMEDIA_IMPORTER_HP_FOURCC,
    "OpenMedia Importer \0",
    "1.0.0.0\0",
    "xImportEntry\0"
END

16000 PiPL DISCARDABLE
BEGIN
    0x0001,
    0x00000000L,
    0x00000007L,

    "8BIM", "kind", 0L, 4L,
    "IMPT",

    "8BIM", "name", 0L, 20L,
    "OpenMedia Importer \0",

    "8BIM", "vers", 0L, 4L,
    0x00010000L,

    "8BIM", "wx86", 0L, 14L,
    "xImportEntry\0\0",

    "8BIM", "fccc", 0L, 4L,
    OPENMEDIA_IMPORTER_HP_FOURCC,

    "8BIM", "immn", 0L, 20L,
    "OpenMedia Importer \0",

    "8BIM", "prio", 0L, 4L,
    0x000000C8L
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x2L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OpenMedia\0"
            VALUE "FileDescription",  "OpenMedia High-Priority Importer\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "OpenMedia_ImporterHP\0"
            VALUE "OriginalFilename", "OpenMedia_ImporterHP.prm\0"
            VALUE "ProductName",      "OpenMedia Importer \0"
            VALUE "ProductVersion",   "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
