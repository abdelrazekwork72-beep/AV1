// OpenMedia Premiere Pro High-Priority Importer Windows Resource Script (v3.0.1)
// PiPL name includes a trailing space ("OpenMedia Importer ") for Dual-PRM priority routing.

#include <winresrc.h>

#define OPENMEDIA_IMPORTER_HP_FOURCC       0x4F4D4948
#define OPENMEDIA_IMPORTER_HP_NAME         "OpenMedia Importer "
#define OPENMEDIA_IMPORTER_HP_ENTRY        "xImportEntry"
#define OPENMEDIA_IMPORTER_HP_VERSION_STR  "1.0.0.0"

1000 IMPT DISCARDABLE
BEGIN
    0x0000,
    0x4E49
END

16000 PiPL DISCARDABLE
BEGIN
    0x0001,
    0x00000000L,
    0x00000003L,

    // Property 1: '8BIM' 'kind' = 'IMPT'
    0x3842494DL,
    0x6B696E64L,
    0x00000000L,
    0x00000004L,
    0x494D5054L,

    // Property 2: '8BIM' 'name' = "\023OpenMedia Importer " (19 chars + 1 len = 20L)
    0x3842494DL,
    0x6E616D65L,
    0x00000000L,
    0x00000014L,
    "\023OpenMedia Importer ",

    // Property 3: '8BIM' 'eMNA' = "\011OpenMedia" (9 chars + 1 len + 2 pad = 12L)
    0x3842494DL,
    0x654D4E41L,
    0x00000000L,
    0x0000000CL,
    "\011OpenMedia\0\0"
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     3,0,1,0
PRODUCTVERSION  3,0,1,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x2L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OpenMedia\0"
            VALUE "FileDescription",  "OpenMedia High-Priority Importer (xImportEntry)\0"
            VALUE "FileVersion",      "3.0.1 (1.0.0.0)\0"
            VALUE "InternalName",     "OpenMedia_ImporterHP\0"
            VALUE "OriginalFilename", "OpenMedia_ImporterHP.prm\0"
            VALUE "ProductName",      "OpenMedia Importer \0"
            VALUE "ProductVersion",   "3.0.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
