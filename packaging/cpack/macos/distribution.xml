<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>OpenMedia Premiere Pro &amp; Media Encoder Plugins</title>
  <options customize="never" require-scripts="false" rootVolumeOnly="true" hostArchitectures="x86_64,arm64" />
  <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true" />
  <choices-outline>
    <line choice="default">
      <line choice="com.openmedia.premiere.mediacore" />
    </line>
  </choices-outline>
  <choice id="default" />
  <choice id="com.openmedia.premiere.mediacore" visible="false">
    <pkg-ref id="com.openmedia.premiere.pkg" />
  </choice>
  <pkg-ref id="com.openmedia.premiere.pkg" version="2.0.0" installKBytes="0">
    #OpenMediaPremierePlugin.pkg
  </pkg-ref>
</installer-gui-script>
